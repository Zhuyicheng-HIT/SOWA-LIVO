<launch>

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find sowa_livo)/config/HILTI22.yaml" />

	<node pkg="sowa_livo" type="sowa_livo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find sowa_livo)/config/camera_fisheye_HILTI22.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find sowa_livo)/rviz_cfg/hilti.rviz" />
	</group>
</launch> 	
