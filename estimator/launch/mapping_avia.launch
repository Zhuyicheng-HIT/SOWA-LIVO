<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find sowa_livo)/config/avia.yaml" />

	<node pkg="sowa_livo" type="sowa_livo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find sowa_livo)/config/camera_pinhole.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find sowa_livo)/rviz_cfg/sowa_livo.rviz" />
	</group>
	
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>
</launch> 	
